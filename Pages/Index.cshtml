@page
@model IndexModel
@{
    ViewData["Title"] = "Olive & Ember | Neighborhood Kitchen";
}

<section class="hero" id="home">
    <div class="hero-content">
        <p class="eyebrow">GOOD FOOD. GOOD COMPANY.</p>
        <h1>A little more<br />time around<br /><em>the table.</em></h1>
        <p class="hero-copy">Seasonal plates, local ingredients, and the kind of welcome that makes you want to stay awhile.</p>
        <a class="button button-light" href="#menu">Explore our menu <span aria-hidden="true">↓</span></a>
    </div>
    <div class="hero-note">
        <span>NEIGHBORHOOD KITCHEN</span>
        <span>EST. 2018 · WELLINGTON</span>
    </div>
</section>

<section class="intro section-wrap" id="story">
    <div class="section-label"><span>01</span> A PLACE TO GATHER</div>
    <div class="intro-copy">
        <h2>Rooted in the<br /><em>season. Made for you.</em></h2>
        <p>At Olive &amp; Ember, we believe the best meals are simple: beautiful ingredients, prepared with care, shared with people you love. Our kitchen follows the seasons and our door is always open.</p>
        <a class="text-link" href="#visit">Come say hello <span aria-hidden="true">↗</span></a>
    </div>
    <div class="intro-stamp" aria-hidden="true"><span>FRESH<br />FROM<br />THE<br />NEIGHBOURHOOD</span></div>
</section>

<section class="menu-section" id="menu">
    <div class="section-wrap menu-wrap">
        <div class="section-label"><span>02</span> FROM OUR KITCHEN</div>
        <div class="menu-heading">
            <h2>A few<br /><em>favourites.</em></h2>
            <p>A taste of what's on the table. Our menu changes with the seasons, so there's always something new to love.</p>
        </div>
        <div class="menu-grid">
            <article class="menu-card">
                <span class="dish-number">01</span>
                <div><h3>Whipped ricotta</h3><p>roasted grapes, sourdough, garden herbs</p></div>
                <span class="price">$16</span>
            </article>
            <article class="menu-card">
                <span class="dish-number">02</span>
                <div><h3>Market greens</h3><p>crisp leaves, pear, toasted hazelnut, lemon</p></div>
                <span class="price">$19</span>
            </article>
            <article class="menu-card">
                <span class="dish-number">03</span>
                <div><h3>Wood-fired chicken</h3><p>charred lemon, rosemary jus, buttery potatoes</p></div>
                <span class="price">$34</span>
            </article>
            <article class="menu-card">
                <span class="dish-number">04</span>
                <div><h3>Wild mushroom pasta</h3><p>hand-cut pappardelle, parmesan, thyme</p></div>
                <span class="price">$29</span>
            </article>
            <article class="menu-card">
                <span class="dish-number">05</span>
                <div><h3>Slow-roasted carrots</h3><p>whipped feta, chilli honey, dukkah</p></div>
                <span class="price">$18</span>
            </article>
            <article class="menu-card">
                <span class="dish-number">06</span>
                <div><h3>Olive oil cake</h3><p>citrus, softly whipped cream, a little sea salt</p></div>
                <span class="price">$14</span>
            </article>
        </div>
        <p class="menu-footnote">A sample menu · ask us about vegetarian, vegan, and gluten-free options.</p>
    </div>
</section>

<section class="visit-section section-wrap" id="visit">
    <div class="section-label"><span>03</span> FIND YOUR WAY</div>
    <div class="visit-grid">
        <div>
            <h2>Your table<br />is <em>waiting.</em></h2>
            <p class="visit-intro">Drop in for a long lunch, a little something after work, or a dinner that turns into the whole evening.</p>
            <a class="button button-dark" href="mailto:hello@oliveandember.nz?subject=Table%20reservation">Make a reservation <span aria-hidden="true">↗</span></a>
        </div>
        <div class="visit-details">
            <div>
                <h3>Come find us</h3>
                <p>42 Cuba Street<br />Te Aro, Wellington 6011</p>
                <a class="text-link" href="https://maps.google.com/?q=42+Cuba+Street+Wellington" target="_blank" rel="noopener noreferrer">Get directions <span aria-hidden="true">↗</span></a>
            </div>
            <div>
                <h3>When we're here</h3>
                <p>Tuesday – Friday <span>11:30 am – late</span><br />Saturday – Sunday <span>10:00 am – late</span><br />Monday <span>Taking a little rest</span></p>
            </div>
            <div>
                <h3>Say hello</h3>
                <p><a href="tel:+6445550142">04 555 0142</a><br /><a href="mailto:hello@oliveandember.nz">hello@oliveandember.nz</a></p>
            </div>
        </div>
    </div>
</section>
